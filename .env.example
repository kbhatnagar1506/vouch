DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Auth — verifies sessions the portal branch issues (see docs/CALLING_AGENT.md
# "Multi-tenancy"). Must be the EXACT SAME value as the portal's JWT_SECRET,
# or sessions it issues won't verify here.
JWT_SECRET=<same value as the portal branch's JWT_SECRET>
# So the session cookie is readable by every subdomain, not just the one
# that set it. Leave unset for local dev (defaults to host-only).
SESSION_COOKIE_DOMAIN=.getvouch.club
# Where to send a signed-out visitor — this branch has no login page itself.
PORTAL_LOGIN_URL=https://login.getvouch.club/login
NEXT_PUBLIC_PORTAL_LOGIN_URL=https://login.getvouch.club/login

# Vapi (see docs/CALLING_AGENT.md) — outbound call orchestration + telephony.
VAPI_API_KEY=<from https://dashboard.vapi.ai, Settings -> API Keys>
# Set after the first `npm run calling-agent:sync-assistant` run (it prints the id).
VAPI_ASSISTANT_ID=<assistant id, from the sync script's output>
VAPI_PHONE_NUMBER_ID=<the Vapi phone number to call from — buy/import one in the Vapi dashboard>

# Where Vapi sends call events (status, transcript, end-of-call-report).
# Must be this deployment's real URL once deployed — see docs/CALLING_AGENT.md.
CALLING_AGENT_WEBHOOK_URL=https://<your-deployment>/api/calling-agent/webhook
# openssl rand -hex 32 — checked against the x-calling-agent-secret header
# Vapi echoes back on every webhook request (see lib/calling-agent/webhook-auth.ts).
CALLING_AGENT_WEBHOOK_SECRET=<random secret>

# ElevenLabs voice, used via Vapi's built-in 11labs voice provider (register
# your ElevenLabs API key as a Vapi Provider Key first — see docs/CALLING_AGENT.md).
ELEVENLABS_VOICE_ID=<voice id from your ElevenLabs Voice Library>

# The assistant's reasoning model. Defaults to Gemini (register your Google
# AI Studio / Gemini API key as a Vapi Provider Key too); any Vapi-supported
# provider works by changing these two — see lib/calling-agent/assistant.ts.
CALLING_AGENT_MODEL_PROVIDER=google
CALLING_AGENT_MODEL=gemini-2.5-flash

# Speaker-match human detection (lib/calling-agent/human-detection.ts) —
# same three values and the same voice-inference Cloud Run service as the
# voice-verification branch (see that branch's docs/VOICE.md for how these
# were obtained). ENCRYPTION_KEY must be the EXACT SAME value as
# voice-verification's, or its voice_enrollments rows won't decrypt here.
ENCRYPTION_KEY=<same value as the voice-verification branch's ENCRYPTION_KEY>
VOICE_SERVICE_URL=<the voice-inference Cloud Run service URL>
VOICE_SERVICE_API_KEY=<same value as voice-verification's VOICE_SERVICE_API_KEY>
GCP_VOICE_CALLER_KEY_BASE64=<same value as voice-verification's GCP_VOICE_CALLER_KEY_BASE64>
