DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Auth — verifies sessions the portal branch issues (see bank-connection's
# docs/PLAID.md "Multi-tenancy"). Must be the EXACT SAME value as the
# portal's JWT_SECRET, or sessions it issues won't verify here.
JWT_SECRET=<same value as the portal branch's JWT_SECRET>
# So the session cookie is readable by every subdomain, not just the one
# that set it. Leave unset for local dev (defaults to host-only).
SESSION_COOKIE_DOMAIN=.getvouch.club

# Where to send a signed-out visitor — this branch has no login page itself.
PORTAL_LOGIN_URL=https://login.getvouch.club/login
NEXT_PUBLIC_PORTAL_LOGIN_URL=https://login.getvouch.club/login

# Stripe Issuing (test/sandbox mode only) — same account as the
# card-issuing branch, needed here only for the "Mint card & renew" action
# on a subscription's decision card. See card-issuing's docs/CARDS.md for
# how these were obtained and what each one means.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_ISSUING_FINANCIAL_ACCOUNT_ID=fa_...

# Vapi (https://vapi.ai) — powers the Sidebar's "Call me" button, which
# places a real outbound call reading out whatever needs your decision.
# Not yet configured anywhere; until these are set, the button returns a
# clear "not configured" error instead of crashing. See docs/DASHBOARD.md
# "Call me".
VAPI_API_KEY=<private key from https://dashboard.vapi.ai/org/api-keys>
VAPI_ASSISTANT_ID=<the assistant to call from, from https://dashboard.vapi.ai/assistants>
VAPI_PHONE_NUMBER_ID=<the Vapi phone number to call from, from https://dashboard.vapi.ai/phone-numbers>
