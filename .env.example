DATABASE_URL=postgresql://vouchapp:<password>@<cloud-sql-ip>:5432/vouch?sslmode=require&uselibpqcompat=true

# Auth — verifies sessions the portal branch issues. Must be the EXACT
# SAME value as the portal's JWT_SECRET, or sessions it issues won't
# verify here.
JWT_SECRET=<same value as the portal branch's JWT_SECRET>
# So the session cookie is readable by every subdomain, not just the one
# that set it. Leave unset for local dev (defaults to host-only).
SESSION_COOKIE_DOMAIN=.getvouch.club

# Where to send a signed-out visitor — this branch has no login page itself.
PORTAL_LOGIN_URL=https://login.getvouch.club/login
NEXT_PUBLIC_PORTAL_LOGIN_URL=https://login.getvouch.club/login

# openssl rand -base64 32 — same treatment (and same value, shared across
# services) as every other branch's ENCRYPTION_KEY. Not currently used for
# anything stored by this branch (no raw card data ever touches it — see
# docs/CARDS.md "PCI scope") but kept for consistency with lib/crypto.ts,
# which every service branch carries.
ENCRYPTION_KEY=<same value as the other service branches' ENCRYPTION_KEY>

# Stripe (test/sandbox mode) — see docs/CARDS.md "Setup".
STRIPE_SECRET_KEY=<sk_test_... from https://dashboard.stripe.com/test/apikeys>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_test_... from the same page>
# From the webhook endpoint's settings after creating it in the Stripe
# dashboard (or `stripe listen` for local dev) — verifies that
# /api/stripe/webhook requests actually came from Stripe.
STRIPE_WEBHOOK_SECRET=<whsec_...>
# This account's Issuing setup requires every card creation call to name
# an explicit financial account (Balances → the "Financial account" row →
# "Financial account ID" in the sidebar, starts with fa_test_...) — see
# docs/CARDS.md "Financial account".
STRIPE_ISSUING_FINANCIAL_ACCOUNT_ID=<fa_test_...>
