DATABASE_URL=postgresql://tsdbadmin:<password>@jc3ifkunpe.y0wwpmpen4.tsdb.cloud.timescale.com:30488/tsdb?sslmode=require

# Auth — verifies sessions the portal branch issues (see docs/VOICE.md
# "Multi-tenancy"). Must be the EXACT SAME value as the portal's
# JWT_SECRET, or sessions it issues won't verify here.
JWT_SECRET=<same value as the portal branch's JWT_SECRET>
# So the session cookie is readable by every subdomain, not just the one
# that set it. Leave unset for local dev (defaults to host-only).
SESSION_COOKIE_DOMAIN=.getvouch.club

# Where to send a signed-out visitor — this branch has no login page itself.
PORTAL_LOGIN_URL=https://login.getvouch.club/login
NEXT_PUBLIC_PORTAL_LOGIN_URL=https://login.getvouch.club/login

# openssl rand -base64 32 — encrypts stored voice embeddings at rest.
ENCRYPTION_KEY=<32 random bytes, base64-encoded>

# The voice-inference service (services/voice-inference), deployed
# separately to Cloud Run — see docs/VOICE.md "Deploying the inference
# service to Cloud Run".
VOICE_SERVICE_URL=https://<voice-inference-cloud-run-url>
VOICE_SERVICE_API_KEY=<shared secret, must match the Cloud Run service's VOICE_SERVICE_API_KEY>
# base64 of the voice-inference-caller service account's JSON key — used to
# mint the Google ID token Cloud Run's IAM invoker check requires (the
# service is deployed private, not --allow-unauthenticated).
GCP_VOICE_CALLER_KEY_BASE64=<base64 -w0 voice-inference-caller-key.json>
