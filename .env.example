DATABASE_URL=postgresql://tsdbadmin:<password>@jc3ifkunpe.y0wwpmpen4.tsdb.cloud.timescale.com:30488/tsdb?sslmode=require

# Plaid (see docs/PLAID.md)
PLAID_CLIENT_ID=<from https://dashboard.plaid.com/team/keys>
PLAID_SECRET=<from https://dashboard.plaid.com/team/keys>
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://<your-deployment>/api/plaid/webhook
# Must exactly match a URI registered in the Plaid dashboard's "Allowed
# redirect URIs" (Developers -> API). Only needed for OAuth institutions.
PLAID_REDIRECT_URI=https://<your-deployment>/bank/oauth-return

# openssl rand -base64 32
ENCRYPTION_KEY=<32 random bytes, base64-encoded>

# Auth — verifies sessions the portal branch issues (see docs/PLAID.md
# "Multi-tenancy"). Must be the EXACT SAME value as the portal's
# JWT_SECRET, or sessions it issues won't verify here.
JWT_SECRET=<same value as the portal branch's JWT_SECRET>
# So the session cookie is readable by every subdomain, not just the one
# that set it. Leave unset for local dev (defaults to host-only).
SESSION_COOKIE_DOMAIN=.getvouch.club

# Where to send a signed-out visitor — this branch has no login page itself.
PORTAL_LOGIN_URL=https://getvouch.club/login
NEXT_PUBLIC_PORTAL_LOGIN_URL=https://getvouch.club/login
