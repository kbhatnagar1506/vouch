DATABASE_URL=postgresql://vouchapp:<password>@<cloud-sql-ip>:5432/vouch?sslmode=require&uselibpqcompat=true

# Auth — verifies sessions the portal branch issues (see docs/GMAIL.md
# "Multi-tenancy"). Must be the EXACT SAME value as the portal's
# JWT_SECRET, or sessions it issues won't verify here.
JWT_SECRET=<same value as the portal branch's JWT_SECRET>
# So the session cookie is readable by every subdomain, not just the one
# that set it. Leave unset for local dev (defaults to host-only).
SESSION_COOKIE_DOMAIN=.getvouch.club

# Where to send a signed-out visitor — this branch has no login page itself.
PORTAL_LOGIN_URL=https://login.getvouch.club/login

# Next step in the onboarding chain once Gmail is connected (or skipped).
BANK_CONNECTION_URL=https://bankconnection.getvouch.club/bank

# openssl rand -base64 32 — encrypts stored Gmail OAuth tokens. Same
# treatment (and same value, shared across services) as bank-connection's
# Plaid tokens and voice-verification's voice embeddings.
ENCRYPTION_KEY=<same value as the other service branches' ENCRYPTION_KEY>

# Google Cloud OAuth 2.0 Web application client credentials — see
# docs/GMAIL.md for how to create these in the Google Cloud Console.
GOOGLE_CLIENT_ID=<from Google Cloud Console -> APIs & Services -> Credentials>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console -> APIs & Services -> Credentials>
# Public base URL of this deployment (no trailing slash) — used to build
# the OAuth redirect URI ({NEXT_PUBLIC_APP_URL}/api/connectors/gmail/callback).
# Must exactly match a URI registered in the OAuth client's "Authorized
# redirect URIs".
NEXT_PUBLIC_APP_URL=https://gmail.getvouch.club
# Optional: overrides the computed redirect URI above if set explicitly.
GOOGLE_REDIRECT_URI=

# Vertex AI text-embedding-004, used to embed Gmail message chunks and
# memory-subsystem content for classification/search (see docs/GMAIL.md
# "Financial email pipeline" and "Memory subsystem"). Authenticated via
# Application Default Credentials (GoogleAuth({scopes:["cloud-platform"]})),
# same as the voice-inference Cloud Run caller — no separate key file needed
# when running on GCP infra with the right service account attached.
GOOGLE_CLOUD_PROJECT=patchguard-reakon
GOOGLE_CLOUD_LOCATION=us-central1

# Bearer secret the Vercel Cron job (or any external scheduler) must send
# to POST /api/cron/gmail-sync — see docs/GMAIL.md "Incremental sync". Fails
# closed: an unset CRON_SECRET always rejects, even with a header set.
# openssl rand -base64 32
CRON_SECRET=<random secret, must match the cron caller's Authorization: Bearer header>

# Backboard.io (app.backboard.io) API key — mirrors classified Gmail
# messages into a per-user Backboard "assistant" for persistent,
# natural-language-queryable memory. Optional: sync (and its local
# lib/memory writes) works fully without this; it's only skipped when unset.
BACKBOARD_API_KEY=<from https://app.backboard.io>

