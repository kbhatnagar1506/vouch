DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Auth — verifies sessions the portal branch issues. Must be the EXACT SAME
# value as the portal's JWT_SECRET, or sessions it issues won't verify here.
JWT_SECRET=<same value as the portal branch's JWT_SECRET>
# So the session cookie is readable by every subdomain, not just the one
# that set it. Leave unset for local dev (defaults to host-only).
SESSION_COOKIE_DOMAIN=.getvouch.club

# Where to send a signed-out visitor — this branch has no login page itself.
PORTAL_LOGIN_URL=https://login.getvouch.club/login
NEXT_PUBLIC_PORTAL_LOGIN_URL=https://login.getvouch.club/login

# Where to return the user after verification.
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.getvouch.club

# --- Persona (withpersona.com) identity verification ---------------------
# Sandbox only. See docs/IDENTITY.md for how each of these is obtained.
#
# Server-side API key. Sandbox keys start with `persona_sandbox_`,
# production with `persona_production_`. NEVER put a production key here.
PERSONA_API_KEY=persona_sandbox_...
# The inquiry template the flow runs (Dashboard -> Inquiries -> Templates).
# Chosen server-side, never by the browser — otherwise a user could point
# the widget at a weaker template than the one we intended.
PERSONA_TEMPLATE_ID=itmpl_...
# Sandbox vs production environment, read by the embedded widget.
NEXT_PUBLIC_PERSONA_ENVIRONMENT_ID=env_...
# Shown once when you create the webhook endpoint in Persona's dashboard.
# Without it the webhook route fails closed (500) rather than trusting
# unsigned events — an accepted unsigned webhook would let anyone who finds
# the URL mark themselves verified, and verified is what lets the agent
# spend money.
PERSONA_WEBHOOK_SECRET=<from Persona -> Webhooks>
